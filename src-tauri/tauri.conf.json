{
  "$schema": "https://raw.githubusercontent.com/nicovank/tauri-v2/main/packages/cli/schema.json",
  "productName": "MultiAlt",
  "version": "1.0.0",
  "identifier": "com.luanmacea.roblox-account-manager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MultiAlt",
        "width": 1100,
        "height": 700,
        "minWidth": 750,
        "minHeight": 450,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Luan Silveira",
    "createUpdaterArtifacts": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "template": "wix-peruser.wxs",
        "upgradeCode": "ea97e4e5-4634-554b-8c91-822b0b369761"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMUREODlFMUI4QTEwNTUKUldSVkVJb2JudGdkcmVKS2Y0U2k3bi9TNUU5b2lremJRWXhrNG91UmRqWFR6cEp3eUZHTis2ZlQK",
      "endpoints": [],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
