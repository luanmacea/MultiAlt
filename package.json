{
  "name": "roblox-account-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "i18n:extract": "bun scripts/i18n/extract-keys.ts",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cd src-tauri && cargo test --all-features",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test:audit && bun run test && bun run test:rust",
    "t": "bun scripts/test-suite.ts",
    "vt": "bun scripts/virustotal.ts",
    "scan": "bun scripts/scan.ts",
    "test:suite": "bun scripts/test-suite.ts",
    "test:audit": "bun scripts/test-suite.ts --audit",
    "dev:ui": "UI_HARNESS=1 vite"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "i18next": "^25.8.7",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^5"
  }
}
